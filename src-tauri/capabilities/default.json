{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Siksik main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}
