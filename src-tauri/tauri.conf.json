{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siksik",
  "version": "1.0.0",
  "identifier": "app.siksik.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Siksik",
        "width": 1080,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Lossless image compression",
    "longDescription": "Siksik shrinks JPEG, PNG and WebP images without losing quality.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
